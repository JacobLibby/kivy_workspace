PageLayoutExample:

<PageLayoutExample>:
    MainWidget:
    BoxLayoutExample:
    AnchorLayoutExample:
    GridLayoutExample:

<ScrollViewExample>:
    StackLayoutExample:
        size_hint:1,None
        height:self.minimum_height


<StackLayoutExample>:
    # left-right,top-bottom
    #orientation: "rl-bt"
    #lrtb
    #padding: ("20dp","20dp","20dp","20dp")
    #spacing: "20dp", "20dp"


